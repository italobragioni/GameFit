# ==========================================================================
# Editor de Vídeos — variáveis de ambiente (EXEMPLO)
# Copie este arquivo para .env (worker) e .env.local (apps/web) e preencha.
# NUNCA coloque credenciais reais neste arquivo. NUNCA faça commit do .env.
# ==========================================================================

# --------------------------------------------------------------------------
# SUPABASE (banco de dados + autenticação + storage)
# Encontrado em: Supabase > Project Settings > API
# --------------------------------------------------------------------------
# URL pública do projeto (pode ficar no frontend)
NEXT_PUBLIC_SUPABASE_URL=https://seuprojeto.supabase.co
# Chave "anon/public" (pode ficar no frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave "service_role" — SECRETA. SÓ no backend/worker. NUNCA no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Nome do bucket de Storage usado para arquivos temporários de upload.
SUPABASE_STORAGE_BUCKET=uploads

# --------------------------------------------------------------------------
# GOOGLE DRIVE (OAuth 2.0)
# Encontrado em: Google Cloud Console > APIs e Serviços > Credenciais
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
# Deve bater EXATAMENTE com o "Authorized redirect URI" no Google Cloud.
# Em produção: https://seu-app.vercel.app/api/drive/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Chave de 32 bytes (base64) para criptografar os tokens OAuth no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=gere-uma-chave-de-32-bytes-em-base64

# --------------------------------------------------------------------------
# APP
# --------------------------------------------------------------------------
# URL pública do site (usada em links e no OAuth). Sem barra no final.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------------
# NOTIFICAÇÕES PUSH (Web Push / PWA) — opcional
# Gere o par de chaves com:  npx web-push generate-vapid-keys
# --------------------------------------------------------------------------
# Chave pública VAPID (pode ficar no frontend).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Chave privada VAPID — SECRETA, só no worker.
VAPID_PRIVATE_KEY=
# Contato do remetente (exigido pelo padrão Web Push).
VAPID_SUBJECT=mailto:voce@exemplo.com

# --------------------------------------------------------------------------
# WORKER (apenas no servidor do worker, não vai para a Vercel)
# --------------------------------------------------------------------------
# Caminho do binário do FFmpeg. Deixe vazio para usar o ffmpeg-static embutido.
# Ex.: /usr/bin/ffmpeg  (se instalou pelo sistema)
FFMPEG_PATH=
# Pasta para arquivos temporários do worker.
WORKER_TMP_DIR=./tmp
# Intervalo (ms) entre verificações da fila quando ela está vazia.
WORKER_POLL_INTERVAL_MS=5000
# Máximo de tentativas por vídeo antes de marcar como "falhou".
WORKER_MAX_ATTEMPTS=3
# Tempo base (ms) de espera entre tentativas (cresce a cada tentativa).
WORKER_RETRY_BACKOFF_MS=2000
# Idade (horas) a partir da qual arquivos temporários abandonados são apagados.
WORKER_CLEANUP_AGE_HOURS=24
