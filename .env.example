# ------------------------------------------------------------------
# Projeto Leve — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com suas chaves.
# ------------------------------------------------------------------

# URL pública do app (usada em redirects de auth e checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: SOMENTE server-side (webhooks). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID do plano Premium (R$19/mês) criado no Stripe
STRIPE_PREMIUM_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Provedor de pagamento ativo: "stripe" | "mercadopago"
BILLING_PROVIDER=stripe
